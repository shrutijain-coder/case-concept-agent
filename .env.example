# --- Data backend -----------------------------------------------------------
# "sqlite"   : local file-backed SQLite (node:sqlite). Zero config, runs today.
# "supabase" : Supabase Postgres + Supabase Auth. Requires the vars below.
DATA_BACKEND=sqlite

# Where the SQLite file lives when DATA_BACKEND=sqlite
SQLITE_PATH=./.data/app.db

# --- Supabase (only needed when DATA_BACKEND=supabase) ----------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Session signing (local auth only) --------------------------------------
# Any long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- AI ---------------------------------------------------------------------
# Provider: "anthropic" or "groq". Defaults to anthropic (or groq if only groq key is present).
AI_PROVIDER=anthropic

# Anthropic config
ANTHROPIC_API_KEY=
# Model used for critical-thinking question generation.
ANTHROPIC_MODEL=claude-haiku-4-5

# Groq config
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
